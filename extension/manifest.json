{
  "manifest_version": 3,
  "name": "Twitter Notes",
  "version": "0.1.0",
  "description": "Private profile notes and tags, stored on your Twitter Notes server.",
  "minimum_chrome_version": "111",
  "permissions": ["storage"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
  "action": {"default_popup": "popup.html", "default_title": "Twitter Notes"},
  "background": {"service_worker": "background.js"},
  "content_scripts": [
    {"matches": ["https://x.com/*", "https://twitter.com/*"], "js": ["bridge.js"], "run_at": "document_start", "world": "MAIN"},
    {"matches": ["https://x.com/*", "https://twitter.com/*"], "js": ["content.js"], "run_at": "document_start"}
  ]
}